# Copy to .env. Everything is optional — defaults run a flawless offline demo.

# Feed source: mock | replay | live
FEED_MODE=mock

# Gateway port (Vite proxies /ws here in dev).
GATEWAY_PORT=8787

# --- live mode handles (only used when FEED_MODE=live) ---
BANKS_TWITCH=fazebanks
ANSEM_KICK_CHATROOM=108796898
ANSEM_KICK_CHANNEL_ID=109086406
ANSEM_KICK_SLUG=ansem

# Optional: Kick live-state via the OFFICIAL API (authoritative current state,
# so an already-live stream reads correctly on connect). Create a free Kick
# developer app for client credentials. Without these we still detect live/offline
# transitions in real time via Kick's Pusher StreamerIsLive/StopStreamBroadcast.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# X is a paid, deliberate stub. Leave unset to keep X silent in live mode.
# Wire a direct X API or a third-party X-stream reseller webhook here.
X_FEED=

# Kick's public Pusher key (override only if Kick rotates it).
KICK_PUSHER_KEY=32cbd69e4b950bf97679

# Replay file (FEED_MODE=replay). Defaults to recordings/demo.jsonl.
REPLAY_FILE=

# Set RECORD=1 with FEED_MODE=live (or `npm run record`) to capture a session.
