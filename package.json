{
  "name": "market-bubble-dash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified chat dashboard for Market Bubble — Banks & Ansem across Twitch, Kick, and X.",
  "scripts": {
    "dev": "concurrently -n gateway,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "record": "FEED_MODE=live RECORD=1 node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.3",
    "vite": "^6.0.7"
  }
}
